# Same Supabase project as the website (.env.local NEXT_PUBLIC_* values).
# The anon key is public by design; Row Level Security limits it to reading listings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Website that receives enquiries at /api/leads
EXPO_PUBLIC_WEB_BASE_URL=https://www.eminentpak.com
